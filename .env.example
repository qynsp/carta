# Database Connection (Neon PostgreSQL)
# Format: postgresql://[user]:[password]@[neon-endpoint].neon.tech/[database]?sslmode=require
DATABASE_URL=

# JWT Secret for server-signed player authentication tokens
JWT_SECRET=your-super-secret-jwt-key-minimum-32-chars

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_URL=https://your-render-app.onrender.com

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Server Environment
NODE_ENV=development
